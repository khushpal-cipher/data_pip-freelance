# Postgres for the running dashboard. Drop this line (or the whole file) and everything
# falls back to sqlite:///./datapipe.db — demo.py and the test suite never need Postgres.
DATABASE_URL=postgresql+psycopg://localhost/datapipe_monitor

CHECK_INTERVAL_SECONDS=60
VOLUME_DROP_THRESHOLD=0.4
VOLUME_MIN_BASELINE=10

# Optional. Unset = alerts are logged only.
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SENTRY_DSN=
