# --- Database ---
DATABASE_URL=postgresql://localhost:5432/refund_reconciler

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=false

# --- Stripe ---
STRIPE_WEBHOOK_SECRET=
STRIPE_API_KEY=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# --- Shopify ---
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2024-10

# --- QuickBooks Online (OAuth2, sandbox) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
QBO_ENVIRONMENT=sandbox
QBO_INCOME_ACCOUNT_ID=
QBO_FX_GAIN_LOSS_ACCOUNT_ID=

# --- Retry policy ---
MAX_TASK_ATTEMPTS=6
RETRY_BACKOFF_BASE_SECONDS=30
RETRY_BACKOFF_MAX_SECONDS=21600

# --- Alerting ---
SENTRY_DSN=

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
