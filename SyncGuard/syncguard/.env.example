# --- Database ---
DATABASE_URL=postgresql://syncguard:syncguard@localhost:5432/syncguard

# --- Shopify ---
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2024-10

# --- QuickBooks Online (OAuth2, sandbox) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
QBO_ENVIRONMENT=sandbox
QBO_INCOME_ACCOUNT_ID=
QBO_FEE_ACCOUNT_ID=
QBO_CLEARING_ACCOUNT_ID=

# --- Worker / reconciliation ---
WORKER_POLL_SECONDS=15
MAX_SYNC_ATTEMPTS=6
RECONCILE_HOUR_UTC=2

# --- Alerting (optional) ---
SENTRY_DSN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
